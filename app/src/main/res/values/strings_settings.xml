    <!-- Settings: Reporting -->
    <string name="settings_reporting">Reporting</string>
    <string name="settings_report_problems">Report problems</string>
    <string name="settings_report_problems_hint">Adds Report a problem to each song\'s ⋮ menu</string>
    <!-- %1$s, %2$s, %3$s are the exact names of three playlists on the server ("Bad: Songs", "Bad: Art", "Bad: Lyrics"). Do not translate them; they are matched against the server. -->
    <string name="settings_report_info">A bad file, wrong art or broken lyrics goes on the server\'s %1$s, %2$s or %3$s playlist for whoever runs it to fix. Songs in %1$s are skipped until they\'re fixed.</string>
    <!-- %1$s is a comma-separated list of exact playlist names (not translatable) -->
    <string name="settings_report_missing">Not found on the server: %1$s.</string>
    <string name="settings_hide_bad">Hide the report playlists</string>
    <!-- %1$s, %2$s, %3$s are the exact names of three server playlists (the kids' lists or the Bad: lists). Do not translate them. -->
    <string name="settings_hide_lists_hint">Keeps %1$s, %2$s and %3$s out of your library.</string>

