    <string name="login_sign_in_peer">Sign in %1$s?</string>
    <!-- %1$s is the name of the other device -->
    <string name="login_play_on_peer">Play on %1$s?</string>
    <!-- %1$s is the name of the other device -->
    <string name="login_check_this_code">Check that %1$s shows this code:</string>
    <!-- %1$s is a kid\'s username -->
    <string name="login_will_sign_in_kid">It will sign in as %1$s, a kid\'s account: approved songs only.</string>
    <!-- %1$s is a username -->
    <string name="login_will_sign_in">It will sign in as %1$s, with your password.</string>
    <string name="login_will_play">It plays with your login until it\'s disconnected. You won\'t be asked again for this device.</string>
    <string name="login_it_matches">It matches</string>

