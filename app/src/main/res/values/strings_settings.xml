    <!-- Settings: kids' accounts (grown-ups only) -->
    <string name="kids_title">Kids</string>
    <!-- %1$s is the kid\'s username -->
    <string name="kids_view_as_description">View as %1$s</string>
    <!-- %1$s is the kid\'s username -->
    <string name="kids_remove_description">Remove %1$s</string>
    <string name="kids_add">Add a kid\'s account</string>
    <string name="kids_how">How kids\' accounts work</string>
    <string name="kids_hide_lists">Hide the kids\' playlists</string>
    <!-- %1$s is the kid\'s username -->
    <string name="kids_remove_title">Remove %1$s?</string>
    <!-- %1$s is the kid\'s username -->
    <string name="kids_remove_message">This device forgets the login. Devices already signed in as %1$s stay signed in.</string>
    <string name="kids_remove">Remove</string>
    <string name="kids_cancel">Cancel</string>
    <string name="kids_help_title">Kids\' accounts</string>
    <string name="kids_help_step1">1. Make each child their own Navidrome account (not an admin) and add it here.</string>
    <string name="kids_help_step2">2. Sign their device in from Sign in a device. Keep their password to yourself.</string>
    <string name="kids_help_step3">3. Choose what they get with three playlists on your account, made when you add a kid:</string>
    <!-- Follows a bold playlist name (not translated) in a list; %1$s is what that playlist does. Keep the leading space ( ). -->
    <string name="kids_help_list_what" translatable="false">" – %1$s"</string>
    <string name="kids_help_approved">songs they can play</string>
    <string name="kids_help_safe_titles">shown greyed out, name only</string>
    <string name="kids_help_safe_art">shown greyed out, with the cover</string>
    <string name="kids_help_hidden">Everything else is hidden from them. These playlists stay out of your library, so edit them in Navidrome\'s web player or another app.</string>
    <string name="kids_help_eye">The eye button shows Seiðr as that kid sees it, without changing anything.</string>
    <string name="kids_got_it">Got it</string>
    <!-- %1$s is the kid\'s username -->
    <string name="kids_view_as_title">View as %1$s?</string>
    <!-- %1$s is the kid\'s username -->
    <string name="kids_view_as_message">Browse with just what %1$s\'s devices show. It\'s read-only: you stay signed in, and songs you play here count as your plays, not %1$s\'s. Go back from the banner on Home or Settings.</string>
    <!-- Button; %1$s is the kid\'s username -->
    <string name="kids_view_as_button">View as %1$s</string>
    <!-- Banner while browsing as a kid; %1$s is the kid\'s username -->
    <string name="kids_viewing_as">Viewing as %1$s</string>
    <!-- Banner button; %1$s is the grown-up\'s own username -->
    <string name="kids_back_to">Back to %1$s</string>
    <string name="kids_own_account">That\'s your own account</string>
    <!-- %1$s is the server address -->
    <string name="kids_add_message">Their Navidrome login on %1$s.</string>
    <!-- In the Add kid dialog and Kids help. %1$s is the "Sign in a device" button label (settings_sign_in_device) -->
    <string name="kids_filter_warning">Only Seiðr filters what they see; Navidrome itself doesn\'t. With this login, Navidrome\'s web player or any other app shows everything. Don\'t give it to them: sign their devices in with “%1$s”.</string>
    <string name="kids_username">Username</string>
    <string name="kids_password">Password</string>
    <string name="kids_add_button">Add</string>

    <!-- Login and signed-out screens -->
    <string name="login_unencrypted_title">Unencrypted connection</string>
    <string name="login_unencrypted_message">This server is on the internet, but its address starts with http://, so your login and music travel unencrypted. Anyone along the way could read them and reuse your login. Use an https:// address if your server has one.</string>
    <string name="login_connect_anyway">Connect anyway</string>
    <string name="login_go_back">Go back</string>
    <string name="login_heading">Connect to your Navidrome server</string>
    <string name="login_server_url">Server URL</string>
    <string name="login_server_url_placeholder" translatable="false">https://music.example.com</string>
    <string name="login_username">Username</string>
    <string name="login_password">Password</string>
    <string name="login_log_in">Log in</string>
    <string name="login_other_device_title">Signed in on another device?</string>
    <!-- %1$s is this device\'s name, as shown on the other device\'s list -->
    <string name="login_other_device_steps">Open Seiðr there and go to Settings → Sign in a device, then pick %1$s. Both need to be on the same Wi-Fi, with Seiðr open on this one. Check the code matches on both screens, and you\'re in.</string>
    <string name="login_back">Back</string>
    <!-- Accessibility description of the app logo -->
    <string name="login_logo_description" translatable="false">Seiðr</string>
    <!-- Status shown on a signed-out device, waiting for someone to play on it. Keep short. -->
    <string name="login_idle_ready">Ready to play</string>
    <string name="login_idle_hint">Open Seiðr on another device, tap Play on, then pick this one.</string>
    <string name="login_pairing_code">Pairing code</string>
    <!-- %1$s is the name of the other device -->
    <string name="login_check_same_code">Check that %1$s shows the same code.</string>
    <string name="login_sign_in_this_device">Sign in this device?</string>
    <!-- %1$s other device\'s name, %2$s username, %3$s server address -->
    <string name="login_sign_in_request">%1$s wants to sign this device in as %2$s on %3$s.</string>
    <!-- Same as above, for a kid\'s account. %1$s other device\'s name, %2$s username, %3$s server address -->
    <string name="login_sign_in_request_kid">%1$s wants to sign this device in as %2$s, a kid\'s account, on %3$s.</string>
    <string name="login_allow">Allow</string>
    <string name="login_dont_allow">Don\'t allow</string>
    <string name="login_cancel">Cancel</string>
