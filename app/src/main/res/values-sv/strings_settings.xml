    <string name="login_unencrypted_title">Okrypterad anslutning</string>
    <string name="login_unencrypted_message">Den här servern ligger på internet, men adressen börjar med http://, så din inloggning och din musik skickas okrypterat. Vem som helst längs vägen kan läsa dem och återanvända din inloggning. Använd en https://-adress om servern har en.</string>
